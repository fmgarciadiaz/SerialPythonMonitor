    "guard_requirements": [
      "Installed CLI binary/version and its actual start/cache behavior must be recorded.",
      "A private same-app rehearsal must restore source archive AND full original cache, including ELF/BIN and build metadata, before starting the original app.",
      "That rehearsal must remove new source files, restore deleted old files, and verify old firmware/relay hashes, source hashes, relay config, CPU state and 10 s recovery.",
      "A reviewed hardware adapter tied to that proven behavior must implement this engine."
    ],
    "preparation": [
      "Acquire V18 board_owner for all Q I/O; verify only Scope V18 and its relay are active.",
      "Capture SPI, generator OFF and WAV IDLE snapshot, firmware/relay identities, container inspect and active/inactive CPU state.",
      "Export original app; verify an exact original-source archive and full cache archive; download original firmware ELF/BIN and mounted relay; persist paired backup manifest.",
      "Stage only accepted arduino/v18 sources; compile firmware before stopping production; hash-gate sources, compiled firmware and already compiled accepted relay.",
      "Copy accepted relay into a new standard digest cache; reject cache collisions; recheck production identity/sources/snapshot and all rollback material."
    ],
    "deployment": [
      "Quiesce acquisition; close receiver before Q administrative operations.",
      "Stop and retain old relay container under a unique saved name; stop Scope V18.",
      "Push exact V18 sources; remove only explicitly enumerated obsolete source files; install the proven prepared-cache layout with accepted firmware.",
      "Start SAME Scope V18 app through the qualified launcher; start new named relay.",
      "Verify accepted binaries/sources, snapshot settings, CPU/relay configuration and 10 s continuous recovery; retain original container and paired backup."
    ],
    "rollback": [
      "One attempt: stop/remove only the transaction-owned new relay; stop Scope V18.",
      "Restore exact original source archive and remove explicitly recorded added sources.",
      "Restore full original cache and metadata, including original ELF/BIN; verify exact original sources/cache/binary hashes BEFORE original app restart.",
      "Start original Scope V18 once; recover retained original relay name/container once.",
      "Restore original CPU baseline and acquisition/generator snapshot; verify original identity, source hashes, relay inspect, CPU state and 10 s recovery.",
      "If source/cache verification fails, do not start any app/relay with uncertain firmware."
    ]
  },
