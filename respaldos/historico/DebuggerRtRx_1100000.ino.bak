#include <Arduino.h>

constexpr uint32_t BAUD = 1100000;

uint8_t buf[512];

void setup() {
  Serial.begin(2000000);
  Serial1.begin(BAUD);
}

void loop() {
  int n = Serial1.available();

  if (n > 0) {
    if (n > (int)sizeof(buf))
      n = sizeof(buf);

    for (int i = 0; i < n; i++)
      buf[i] = Serial1.read();

    Serial.write(buf, n);
  }
}